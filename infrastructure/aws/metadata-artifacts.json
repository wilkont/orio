{
 "AWSTemplateFormatVersion":"2010-09-09",
 "Description":"ORIO owner-only versioned metadata deployment artifacts; no credentials or customer records",
 "Conditions":{"Target":{"Fn::And":[{"Fn::Equals":[{"Ref":"AWS::AccountId"},"720232346199"]},{"Fn::Equals":[{"Ref":"AWS::Region"},"us-east-1"]}]}},
 "Resources":{
  "Artifacts":{"Type":"AWS::S3::Bucket","Condition":"Target","Properties":{
   "BucketName":"orio-metadata-artifacts-720232346199-us-east-1",
   "OwnershipControls":{"Rules":[{"ObjectOwnership":"BucketOwnerEnforced"}]},
   "PublicAccessBlockConfiguration":{"BlockPublicAcls":true,"BlockPublicPolicy":true,"IgnorePublicAcls":true,"RestrictPublicBuckets":true},
   "BucketEncryption":{"ServerSideEncryptionConfiguration":[{"ServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]},
   "VersioningConfiguration":{"Status":"Enabled"}
  }},
  "TransportPolicy":{"Type":"AWS::S3::BucketPolicy","Condition":"Target","Properties":{
   "Bucket":{"Ref":"Artifacts"},"PolicyDocument":{"Version":"2012-10-17","Statement":[{
    "Sid":"RequireTLS","Effect":"Deny","Principal":"*","Action":"s3:*",
    "Resource":["arn:aws:s3:::orio-metadata-artifacts-720232346199-us-east-1","arn:aws:s3:::orio-metadata-artifacts-720232346199-us-east-1/*"],
    "Condition":{"Bool":{"aws:SecureTransport":"false"}}
   }]}
  }}
 }
}
