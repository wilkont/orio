{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "ORIO disabled qualification signing key; no Sign permission or financial activation",
  "Parameters": {
    "KeyAdministratorArn": {
      "Type": "String",
      "Default": "arn:aws:iam::720232346199:user/orio/orio-operator",
      "AllowedValues": [
        "arn:aws:iam::720232346199:user/orio/orio-operator"
      ],
      "Description": "Existing dedicated ORIO operator; verify principal before creation"
    }
  },
  "Resources": {
    "QualificationGasKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "ORIO company-operated Base Sepolia gas qualification key - initially disabled",
        "Enabled": false,
        "BypassPolicyLockoutSafetyCheck": false,
        "KeySpec": "ECC_SECG_P256K1",
        "KeyUsage": "SIGN_VERIFY",
        "MultiRegion": false,
        "Origin": "AWS_KMS",
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AccountKeyAdministrationOnly",
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::720232346199:root"
              },
              "Action": [
                "kms:DescribeKey",
                "kms:GetKeyPolicy",
                "kms:PutKeyPolicy",
                "kms:EnableKey",
                "kms:DisableKey",
                "kms:UpdateKeyDescription",
                "kms:TagResource",
                "kms:UntagResource",
                "kms:ListResourceTags",
                "kms:CreateAlias"
              ],
              "Resource": "*"
            },
            {
              "Sid": "DedicatedOperatorAdministrationAndPublicInspection",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "KeyAdministratorArn"
                }
              },
              "Action": [
                "kms:DescribeKey",
                "kms:GetKeyPolicy",
                "kms:PutKeyPolicy",
                "kms:EnableKey",
                "kms:DisableKey",
                "kms:UpdateKeyDescription",
                "kms:TagResource",
                "kms:UntagResource",
                "kms:ListResourceTags",
                "kms:GetPublicKey"
              ],
              "Resource": "*"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "ORIO-SPC-3"
          },
          {
            "Key": "Environment",
            "Value": "qualification"
          },
          {
            "Key": "Purpose",
            "Value": "gas-signing"
          }
        ]
      },
      "Condition": "TargetAccountAndRegion"
    },
    "QualificationGasAlias": {
      "Type": "AWS::KMS::Alias",
      "Properties": {
        "AliasName": "alias/orio-spc-3-gas-qualification",
        "TargetKeyId": {
          "Ref": "QualificationGasKey"
        }
      },
      "Condition": "TargetAccountAndRegion"
    }
  },
  "Outputs": {
    "KeyArn": {
      "Value": {
        "Fn::GetAtt": [
          "QualificationGasKey",
          "Arn"
        ]
      },
      "Condition": "TargetAccountAndRegion"
    },
    "QualificationOnly": {
      "Value": "Disabled key; no signing grant, workload, blockchain transaction or financial activation",
      "Condition": "TargetAccountAndRegion"
    }
  },
  "Conditions": {
    "TargetAccountAndRegion": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::AccountId"
            },
            "720232346199"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::Region"
            },
            "us-east-1"
          ]
        }
      ]
    }
  }
}
