{
 "AWSTemplateFormatVersion":"2010-09-09",
 "Description":"Temporary private ORIO hosted schema audit network; no IAM or database writes",
 "Conditions":{"Target":{"Fn::And":[{"Fn::Equals":[{"Ref":"AWS::AccountId"},"720232346199"]},{"Fn::Equals":[{"Ref":"AWS::Region"},"us-east-1"]}]}},
 "Resources":{
  "AuditSecurityGroup":{"Type":"AWS::EC2::SecurityGroup","Condition":"Target","Properties":{
   "GroupDescription":"Temporary ORIO audit session; database and Secrets Manager only",
   "VpcId":"vpc-05613af21236d6911",
   "SecurityGroupEgress":[{"IpProtocol":"tcp","FromPort":5432,"ToPort":5432,"DestinationSecurityGroupId":"sg-030c057c133762083"}],
   "Tags":[{"Key":"Project","Value":"ORIO-SPC-3"},{"Key":"Purpose","Value":"temporary-hosted-audit"}]}},
  "EndpointSecurityGroup":{"Type":"AWS::EC2::SecurityGroup","Condition":"Target","Properties":{
   "GroupDescription":"Temporary ORIO audit Secrets Manager endpoint",
   "VpcId":"vpc-05613af21236d6911",
   "SecurityGroupEgress":[{"IpProtocol":"tcp","FromPort":1,"ToPort":1,"CidrIp":"127.0.0.1/32"}],
   "Tags":[{"Key":"Project","Value":"ORIO-SPC-3"},{"Key":"Purpose","Value":"temporary-hosted-audit"}]}},
  "EndpointIngress":{"Type":"AWS::EC2::SecurityGroupIngress","Condition":"Target","Properties":{
   "GroupId":{"Ref":"EndpointSecurityGroup"},"IpProtocol":"tcp","FromPort":443,"ToPort":443,"SourceSecurityGroupId":{"Ref":"AuditSecurityGroup"}}},
  "AuditEndpointEgress":{"Type":"AWS::EC2::SecurityGroupEgress","Condition":"Target","Properties":{
   "GroupId":{"Ref":"AuditSecurityGroup"},"IpProtocol":"tcp","FromPort":443,"ToPort":443,"DestinationSecurityGroupId":{"Ref":"EndpointSecurityGroup"}}},
  "DatabaseIngress":{"Type":"AWS::EC2::SecurityGroupIngress","Condition":"Target","Properties":{
   "GroupId":"sg-030c057c133762083","IpProtocol":"tcp","FromPort":5432,"ToPort":5432,"SourceSecurityGroupId":{"Ref":"AuditSecurityGroup"}}},
  "SecretsEndpoint":{"Type":"AWS::EC2::VPCEndpoint","Condition":"Target","Properties":{
   "VpcId":"vpc-05613af21236d6911","VpcEndpointType":"Interface","ServiceName":"com.amazonaws.us-east-1.secretsmanager",
   "PrivateDnsEnabled":true,"SubnetIds":["subnet-074b44d8936032ab9"],"SecurityGroupIds":[{"Ref":"EndpointSecurityGroup"}],
   "PolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":"*",
    "Action":["secretsmanager:GetSecretValue","secretsmanager:DescribeSecret"],
    "Resource":"arn:aws:secretsmanager:us-east-1:720232346199:secret:rds!db-1bf19966-f3d1-41b1-8bbb-f3091801fe5f-IOWCi7",
    "Condition":{"ArnEquals":{"aws:PrincipalArn":"arn:aws:iam::720232346199:root"}}}]},
   "Tags":[{"Key":"Project","Value":"ORIO-SPC-3"},{"Key":"Purpose","Value":"temporary-hosted-audit"}]}}
 },
 "Outputs":{
  "AuditSecurityGroup":{"Condition":"Target","Value":{"Ref":"AuditSecurityGroup"}},
  "EndpointId":{"Condition":"Target","Value":{"Ref":"SecretsEndpoint"}},
  "SubnetId":{"Condition":"Target","Value":"subnet-074b44d8936032ab9"},
  "VpcId":{"Condition":"Target","Value":"vpc-05613af21236d6911"}
 }
}
