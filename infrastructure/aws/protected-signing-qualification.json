{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "ORIO existing qualification key plus private fixed-challenge verification",
  "Parameters": {
    "KeyAdministratorArn": {
      "Type": "String",
      "Default": "arn:aws:iam::720232346199:user/orio/orio-operator",
      "AllowedValues": [
        "arn:aws:iam::720232346199:user/orio/orio-operator"
      ],
      "Description": "Existing dedicated ORIO operator; verify principal before creation"
    }
  },
  "Resources": {
    "QualificationGasKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "ORIO company-operated Base Sepolia gas qualification key - initially disabled",
        "Enabled": true,
        "BypassPolicyLockoutSafetyCheck": false,
        "KeySpec": "ECC_SECG_P256K1",
        "KeyUsage": "SIGN_VERIFY",
        "MultiRegion": false,
        "Origin": "AWS_KMS",
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AccountKeyAdministrationOnly",
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::720232346199:root"
              },
              "Action": [
                "kms:DescribeKey",
                "kms:GetKeyPolicy",
                "kms:PutKeyPolicy",
                "kms:EnableKey",
                "kms:DisableKey",
                "kms:UpdateKeyDescription",
                "kms:TagResource",
                "kms:UntagResource",
                "kms:ListResourceTags",
                "kms:CreateAlias"
              ],
              "Resource": "*"
            },
            {
              "Sid": "DedicatedOperatorAdministrationAndPublicInspection",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "KeyAdministratorArn"
                }
              },
              "Action": [
                "kms:DescribeKey",
                "kms:GetKeyPolicy",
                "kms:PutKeyPolicy",
                "kms:EnableKey",
                "kms:DisableKey",
                "kms:UpdateKeyDescription",
                "kms:TagResource",
                "kms:UntagResource",
                "kms:ListResourceTags",
                "kms:GetPublicKey"
              ],
              "Resource": "*"
            },
            {
              "Effect": "Allow",
              "Action": [
                "kms:GetPublicKey"
              ],
              "Resource": "*",
              "Principal": {
                "AWS": {
                  "Fn::GetAtt": [
                    "QualificationRole",
                    "Arn"
                  ]
                }
              },
              "Sid": "FixedChallenge0"
            },
            {
              "Effect": "Allow",
              "Action": [
                "kms:Sign"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "kms:MessageType": "DIGEST",
                  "kms:SigningAlgorithm": "ECDSA_SHA_256"
                }
              },
              "Principal": {
                "AWS": {
                  "Fn::GetAtt": [
                    "QualificationRole",
                    "Arn"
                  ]
                }
              },
              "Sid": "FixedChallenge1"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "ORIO-SPC-3"
          },
          {
            "Key": "Environment",
            "Value": "qualification"
          },
          {
            "Key": "Purpose",
            "Value": "gas-signing"
          }
        ]
      },
      "Condition": "TargetAccountAndRegion"
    },
    "QualificationGasAlias": {
      "Type": "AWS::KMS::Alias",
      "Properties": {
        "AliasName": "alias/orio-spc-3-gas-qualification",
        "TargetKeyId": {
          "Ref": "QualificationGasKey"
        }
      },
      "Condition": "TargetAccountAndRegion"
    },
    "QualificationRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "TargetAccountAndRegion",
      "Properties": {
        "RoleName": "orio-spc-3-key-qualification",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "QualificationPermissions": {
      "Type": "AWS::IAM::Policy",
      "Condition": "TargetAccountAndRegion",
      "Properties": {
        "PolicyName": "orio-fixed-challenge-key-access",
        "Roles": [
          {
            "Ref": "QualificationRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "kms:GetPublicKey"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "QualificationGasKey",
                  "Arn"
                ]
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "kms:Sign"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "QualificationGasKey",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "kms:MessageType": "DIGEST",
                  "kms:SigningAlgorithm": "ECDSA_SHA_256"
                }
              }
            }
          ]
        }
      }
    },
    "QualificationFunction": {
      "Type": "AWS::Lambda::Function",
      "Condition": "TargetAccountAndRegion",
      "DependsOn": "QualificationPermissions",
      "Properties": {
        "FunctionName": "orio-spc-3-key-qualification",
        "Description": "Private fixed non-monetary Base Sepolia challenge; no financial requests",
        "Runtime": "python3.13",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "QualificationRole",
            "Arn"
          ]
        },
        "Timeout": 15,
        "MemorySize": 128,
        "ReservedConcurrentExecutions": 1,
        "Code": {
          "ZipFile": "import base64\nimport boto3\nfrom botocore.config import Config\nKEY = \"arn:aws:kms:us-east-1:720232346199:key/479ae4e7-483e-4d17-8f46-232f08c5c6ee\"\nDIGEST = \"cdce4ceb5056824b8e445297e1b6edd710f5d8921aa72867985809521d5a2ddb\"\ndef handler(event, context):\n    if type(event) is not dict or event != {}:\n        raise ValueError(\"Only the fixed qualification challenge is authorized\")\n    client = boto3.client(\"kms\", region_name=\"us-east-1\", config=Config(connect_timeout=3, read_timeout=3, retries={\"total_max_attempts\":1}))\n    public = client.get_public_key(KeyId=KEY)\n    if public.get(\"KeyId\") != KEY or public.get(\"KeySpec\") != \"ECC_SECG_P256K1\" or public.get(\"KeyUsage\") != \"SIGN_VERIFY\" or \"ECDSA_SHA_256\" not in public.get(\"SigningAlgorithms\", []):\n        raise ValueError(\"Unexpected protected identity\")\n    signed = client.sign(KeyId=KEY, Message=bytes.fromhex(DIGEST), MessageType=\"DIGEST\", SigningAlgorithm=\"ECDSA_SHA_256\")\n    if signed.get(\"KeyId\") != KEY or signed.get(\"SigningAlgorithm\") != \"ECDSA_SHA_256\":\n        raise ValueError(\"Unexpected signing response\")\n    return {\"keyArn\":KEY, \"digest\":\"0x\"+DIGEST, \"publicKey\":base64.b64encode(public[\"PublicKey\"]).decode(), \"signature\":base64.b64encode(signed[\"Signature\"]).decode(), \"financialExecutionEnabled\":False}\n"
        }
      }
    },
    "OperatorQualificationInvoke": {
      "Type": "AWS::IAM::Policy",
      "Condition": "TargetAccountAndRegion",
      "Properties": {
        "PolicyName": "orio-invoke-fixed-key-qualification",
        "Users": [
          "orio-operator"
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "lambda:InvokeFunction"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "QualificationFunction",
                  "Arn"
                ]
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "KeyArn": {
      "Value": {
        "Fn::GetAtt": [
          "QualificationGasKey",
          "Arn"
        ]
      },
      "Condition": "TargetAccountAndRegion"
    },
    "QualificationOnly": {
      "Value": "Enabled qualification key; private fixed-challenge function only; no monetary permit or financial activation",
      "Condition": "TargetAccountAndRegion"
    }
  },
  "Conditions": {
    "TargetAccountAndRegion": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::AccountId"
            },
            "720232346199"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::Region"
            },
            "us-east-1"
          ]
        }
      ]
    }
  }
}
