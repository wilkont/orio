{
  "name": "@orio/control-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "simulate:monetary": "node scripts/simulate-monetary.mjs",
    "start": "node src/server.ts",
    "check:providers": "node scripts/check-providers.mjs",
    "check:bundler": "node scripts/check-bundler.mjs",
    "check:base-public": "node scripts/check-base-public.mjs",
    "check:provider-session": "node scripts/provider-session.mjs",
    "test:provider-session": "node --test test/provider-session.test.mjs",
    "test:container": "node scripts/test-container.mjs",
    "typecheck": "tsc --noEmit",
    "test:local": "node scripts/test-local.mjs",
    "test:unit": "node --test test/release.test.ts",
    "test:integration": "node --test test/ledger.test.ts",
    "test": "node --test test/*.test.ts test/*.test.mjs"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
